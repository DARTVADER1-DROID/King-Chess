HOST=0.0.0.0
PORT=3001
WEB_ORIGIN=http://localhost:5173
# Optional Stockfish UCI executable; defaults to `stockfish` on PATH.
STOCKFISH_PATH=stockfish

# Render PostgreSQL connection string. Leave unset to disable account endpoints locally.
DATABASE_URL=
# Set false only for local PostgreSQL without TLS.
DATABASE_SSL=true
DATABASE_POOL_SIZE=10
